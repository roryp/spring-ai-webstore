{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=rg-trail-store}" },
    "phase": { "value": "${STORE_PHASE=3}" },
    "webAppExists": { "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}" },
    "minReplicas": { "value": "${MIN_REPLICAS=0}" },
    "aiLocation": { "value": "${AZURE_AI_LOCATION=swedencentral}" },
    "developerPrincipalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "workshopAccessCodeHash": { "value": "${WORKSHOP_ACCESS_CODE_HASH=}" },
    "modelName": { "value": "${AZURE_MODEL_NAME=gpt-6-luna}" },
    "modelVersion": { "value": "${AZURE_MODEL_VERSION=2026-09-22}" },
    "modelCapacity": { "value": "${AZURE_MODEL_CAPACITY=100}" }
  }
}
